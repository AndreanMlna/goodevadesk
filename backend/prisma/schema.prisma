// ==============================================================================
// GoodevaDesk - Prisma Schema Definition
// ==============================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TicketStatus {
  open
  in_progress
  closed
}

model Organization {
  id         String   @id @default(uuid())
  name       String
  api_key    String   @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tickets Ticket[]

  @@map("organizations")
}

model Ticket {
  id              String       @id @default(uuid())
  organization_id String
  customer_email  String
  subject         String
  message         String       @db.Text
  category        String?      // e.g. "billing", "technical", "general"
  suggested_reply String?      @db.Text
  status          TicketStatus @default(open)
  
  // Smart SLA Triage & AI Sentiment Analytics (Enterprise Extensions)
  priority        String       @default("normal") // "critical", "high", "normal", "low"
  assigned_to     String?      // e.g. "Sarah Connor (Tier 2)", "Alex Mercer (Billing)"
  sla_deadline    DateTime?
  sentiment       String?      // "positive", "neutral", "frustrated", "angry"
  urgency_score   Float?       // 0.0 to 1.0
  grounding_doc   String?      // Reference to grounded SOP document

  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  organization Organization     @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  feedbacks    TicketFeedback[]
  messages     TicketMessage[]
  audit_logs   AuditLog[]

  // Indexes optimized for multi-tenant query patterns & filtering
  @@index([organization_id])
  @@index([organization_id, status])
  @@index([organization_id, category])
  @@index([organization_id, priority])
  @@index([organization_id, assigned_to])
  @@index([created_at])
  @@map("tickets")
}

model TicketFeedback {
  id              String   @id @default(uuid())
  ticket_id       String
  organization_id String
  rating          String   // "thumbs_up" | "thumbs_down"
  edited_reply    String?  @db.Text
  agent_notes     String?  @db.Text
  created_at      DateTime @default(now())

  ticket Ticket @relation(fields: [ticket_id], references: [id], onDelete: Cascade)

  @@index([ticket_id])
  @@index([organization_id])
  @@map("ticket_feedbacks")
}

// ==============================================================================
// Enterprise Extension: Multi-Turn Threaded Messages & Internal Whispers
// ==============================================================================
model TicketMessage {
  id              String   @id @default(uuid())
  ticket_id       String
  organization_id String
  sender_type     String   // "customer" | "agent" | "internal_note" | "system"
  sender_name     String
  sender_email    String?
  content         String   @db.Text
  created_at      DateTime @default(now())

  ticket Ticket @relation(fields: [ticket_id], references: [id], onDelete: Cascade)

  @@index([ticket_id])
  @@index([organization_id])
  @@index([created_at])
  @@map("ticket_messages")
}

// ==============================================================================
// Enterprise Extension: Immutable Audit Logging (SOC-2 & ISO 27001 Readiness)
// ==============================================================================
model AuditLog {
  id              String   @id @default(uuid())
  organization_id String
  ticket_id       String?
  actor_name      String
  action          String   // "ticket_created" | "status_changed" | "priority_changed" | "assigned" | "reply_sent" | "internal_note_added" | "feedback_submitted"
  details         String?  @db.Text
  created_at      DateTime @default(now())

  ticket Ticket? @relation(fields: [ticket_id], references: [id], onDelete: Cascade)

  @@index([ticket_id])
  @@index([organization_id])
  @@index([created_at])
  @@map("audit_logs")
}
