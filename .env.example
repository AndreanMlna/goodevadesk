# ==============================================================================
# GoodevaDesk - Environment Configuration
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=3000

# PostgreSQL Database (Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://goodeva_user:goodeva_secret_2026@localhost:5432/goodevadesk_db?schema=public

# Redis Configuration (Ticket Classification Caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CACHE_TTL_SECONDS=86400

# LLM Configuration (OpenAI, Anthropic, Gemini, or Mock)
# Set LLM_PROVIDER to 'openai', 'anthropic', 'gemini', or 'mock'
# If API key is not provided, system seamlessly uses 'mock' mode for zero-config local testing!
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Python NLP Service (Optional Bonus)
PYTHON_NLP_SERVICE_URL=http://localhost:8000

# CORS Allowed Origins
CORS_ORIGINS=https://goodevadesk.vercel.app,http://localhost:5173,http://localhost:3000
